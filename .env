# API Keys and Credentials
OPENAI_API_KEY=your_openai_api_key
NEWS_API_KEY=your_news_api_key
SLACK_BOT_TOKEN=your_slack_bot_token
SLACK_APP_TOKEN=your_slack_app_token
GOOGLE_CALENDAR_ID=your_calendar_id

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Git Configuration
GIT_USERNAME=your_git_username
GIT_EMAIL=your_git_email
GIT_TOKEN=your_git_token  # Personal Access Token for authentication

# Email Service Configuration
EMAIL_SERVICE=SMTP  # Can be SMTP, SendGrid, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=your_service_account@gmail.com
SMTP_PASSWORD=your_app_specific_password

# Slack Channel IDs
SLACK_GENERAL_CHANNEL=your_general_channel_id
SLACK_ANNOUNCEMENTS_CHANNEL=your_announcements_channel_id

# Default Phone Numbers
DEFAULT_CONTACT_PHONE=your_default_contact_phone
DEFAULT_COUNTRY_CODE=+1
